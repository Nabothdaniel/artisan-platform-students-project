rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidRole(role) {
      return role in ['customer', 'artisan', 'admin'];
    }

    function isValidKycStatus(status) {
      return status in ['unsubmitted', 'pending', 'approved', 'rejected'];
    }

    function isValidSkillTestStatus(status) {
      return status in ['pending', 'passed', 'failed'];
    }

    function isValidBookingStatus(status) {
      return status in ['requested', 'bidding_open', 'accepted', 'in_progress', 'completed', 'cancelled'];
    }

    function isValidBidStatus(status) {
      return status in ['pending', 'accepted', 'rejected'];
    }

    // =========================================================================
    // 1. Skills & Competency Questions
    // Publicly readable so customers and artisans can browse trades & quizzes.
    // Writes require authentication and valid schema fields; deletion is blocked.
    // =========================================================================
    match /skills/{skillId} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && request.resource.data.id is number
        && isValidString(request.resource.data.name, 2, 120)
        && isValidString(request.resource.data.category, 2, 120)
        && request.resource.data.questions is list;
      allow delete: if false;
    }

    // =========================================================================
    // 2. Users & Embedded Artisan Profiles
    // Readable for marketplace artisan discovery and booking/bid hydration.
    // Creation requires Firebase Auth session + valid role & email.
    // Updates cannot alter user ID or email address; deletion is blocked.
    // =========================================================================
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.id is number
        && isValidString(request.resource.data.name, 1, 120)
        && isValidString(request.resource.data.email, 3, 150)
        && isValidRole(request.resource.data.role);
      allow update: if isSignedIn()
        && request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email
        && isValidRole(request.resource.data.role)
        && (
          request.resource.data.artisan_profile == null || (
            isValidKycStatus(request.resource.data.artisan_profile.kyc_status) &&
            isValidSkillTestStatus(request.resource.data.artisan_profile.skill_test_status)
          )
        );
      allow delete: if false;
    }

    // =========================================================================
    // 3. KYC Identity Verification Submissions
    // Artisans submit NIN/BVN tokens; Admins approve or reject submissions.
    // Deletion is blocked to preserve verification compliance history.
    // =========================================================================
    match /kyc_verifications/{kycId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.id is number
        && request.resource.data.id_type in ['NIN', 'BVN']
        && isValidString(request.resource.data.id_token, 5, 100)
        && isValidKycStatus(request.resource.data.status);
      allow update: if isSignedIn()
        && request.resource.data.id == resource.data.id
        && request.resource.data.id_token == resource.data.id_token
        && isValidKycStatus(request.resource.data.status);
      allow delete: if false;
    }

    // =========================================================================
    // 4. Customer Service Bookings
    // Customers create jobs; status updates transition through booking lifecycle.
    // Ownership (`customer_id`) is immutable after creation; deletion is blocked.
    // =========================================================================
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.id is number
        && request.resource.data.customer_id is number
        && request.resource.data.skill_id is number
        && isValidString(request.resource.data.title, 2, 200)
        && isValidString(request.resource.data.description, 2, 2000)
        && request.resource.data.budget is number
        && request.resource.data.budget >= 0
        && isValidBookingStatus(request.resource.data.status);
      allow update: if isSignedIn()
        && request.resource.data.id == resource.data.id
        && request.resource.data.customer_id == resource.data.customer_id
        && isValidBookingStatus(request.resource.data.status);
      allow delete: if false;
    }

    // =========================================================================
    // 5. Artisan Negotiable Bids
    // Artisans submit or update price quotes; Customers accept/reject quotes.
    // `booking_id` and `artisan_id` cannot be reassigned; deletion is blocked.
    // =========================================================================
    match /bids/{bidId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.id is number
        && request.resource.data.booking_id is number
        && request.resource.data.artisan_id is number
        && request.resource.data.proposed_price is number
        && request.resource.data.proposed_price > 0
        && isValidBidStatus(request.resource.data.status);
      allow update: if isSignedIn()
        && request.resource.data.id == resource.data.id
        && request.resource.data.booking_id == resource.data.booking_id
        && request.resource.data.artisan_id == resource.data.artisan_id
        && request.resource.data.proposed_price is number
        && request.resource.data.proposed_price > 0
        && isValidBidStatus(request.resource.data.status);
      allow delete: if false;
    }

    // =========================================================================
    // 6. Customer Reviews & Star Ratings (1 to 5 stars)
    // Immutable once created: no updates or deletions allowed.
    // =========================================================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.id is number
        && request.resource.data.booking_id is number
        && request.resource.data.customer_id is number
        && request.resource.data.artisan_id is number
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }

    // =========================================================================
    // 7. Security & Platform Audit Logs
    // Append-only ledger: authenticated operations can create entries,
    // but no one can modify or delete existing audit logs.
    // =========================================================================
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.id is number
        && isValidString(request.resource.data.action, 2, 100)
        && isValidString(request.resource.data.timestamp, 10, 60);
      allow update, delete: if false;
    }

    // =========================================================================
    // 8. Auto-Increment Sequence Counters
    // =========================================================================
    match /counters/{counterId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Deny access to any unknown collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
